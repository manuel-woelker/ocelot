fun identity(name: string) -> string {
    name
}

fun greeting(enabled: bool) -> string {
    if enabled {
        identity(name: "hello")
    } else {
        "goodbye"
    }
}

fun skipped() -> bool {
    assert(false);
    true
}

fun guarded(enabled: bool) -> bool {
    enabled and {
        let copy = identity(name: "allocated");
        assert(copy == "allocated");
        return true;
    }
}

fun early() -> string {
    ({
        return "early";
    }) or skipped()
}

let message = greeting(enabled: true);
{
    let message = "${message} native";
    println(message);
};
println(message);
assert(message == "hello");
assert((false and skipped()) == false);
assert(true or skipped());
assert(not (guarded(enabled: false)));
assert(guarded(enabled: true));
assert_eq(expected: "early", actual: early());
