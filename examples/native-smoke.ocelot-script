fun identity(name: string) -> string {
    name
}

fun greeting(enabled: bool) -> string {
    if enabled {
        identity(name: "hello")
    } else {
        "goodbye"
    }
}

fun skipped() -> bool {
    assert(false);
    true
}

fun guarded(enabled: bool) -> bool {
    enabled and {
        let copy = identity(name: "allocated");
        assert(copy == "allocated");
        return true;
    }
}

fun early() -> string {
    ({
        return "early";
    }) or skipped()
}

let message = greeting(enabled: true);
{
    let message = "${message} native";
    println(message);
};
println(message);
assert(message == "hello");
assert((false and skipped()) == false);
assert(true or skipped());
assert(not (guarded(enabled: false)));
assert(guarded(enabled: true));
assert_eq(expected: "early", actual: early());
let min: int = -9223372036854775808;
let max: int = 9223372036854775807;
assert(min < max);
assert_eq(expected: -2, actual: (-7) / 3);
assert_eq(expected: 42, actual: (6 * 7));
assert_eq(expected: "-9223372036854775808:9223372036854775807", actual: "${min}:${max}");
assert((false and ((1 / 0) == 0)) == false);
